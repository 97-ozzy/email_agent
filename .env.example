# Required OpenRouter settings
OPENROUTER_API_KEY=replace-with-your-openrouter-api-key
OPENROUTER_MODEL=openai/gpt-4.1-mini

# Local infrastructure (defaults shown)
QDRANT_URL=http://localhost:6333
OLLAMA_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=bge-m3

# Set true only when troubleshooting; normal mode hides tracebacks.
EMAIL_AGENT_DEBUG=false
