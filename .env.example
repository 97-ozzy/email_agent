# Required OpenRouter settings
OPENROUTER_API_KEY=replace-with-your-openrouter-api-key
OPENROUTER_MODEL=openai/gpt-6-luna

# Local infrastructure (defaults shown)
QDRANT_URL=http://localhost:6333
EMAIL_AGENT_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B

# Initial local archive (defaults shown)
EMAIL_AGENT_INITIAL_IMPORT_LIMIT=10
EMAIL_AGENT_DATA_DIR=data
EMAIL_AGENT_ATTACHMENT_MAX_BYTES=20971520
EMAIL_AGENT_SEARCH_CONTEXT_CHARS=1000000
EMAIL_AGENT_SEARCH_CONTEXT_TOKENS=6000
EMAIL_AGENT_DOCUMENT_CONTEXT_TOKENS=3000
EMAIL_AGENT_TOOL_CALL_LIMIT=10

# Set true only when troubleshooting; normal mode hides tracebacks.
EMAIL_AGENT_DEBUG=false

# Optional local Langfuse tracing (project keys, separate from OpenRouter).
LANGFUSE_ENABLED=false
LANGFUSE_BASE_URL=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_ENVIRONMENT=local
# Text debugging only; credentials, binary data and raw exception messages stay excluded.
LANGFUSE_CAPTURE_CONTENT=false
